{
  "name": "@trpc-rs-py/link",
  "version": "0.9.0",
  "description": "Migration link for moving a Node tRPC app to trpc-rs-py one procedure at a time",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "docs": "typedoc --out docs --entryPoints src --name trpc-rs-py-link"
  },
  "peerDependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0"
  },
  "devDependencies": {
    "@trpc/client": "11.25.0",
    "@trpc/server": "11.25.0",
    "@types/node": "^24.10.0",
    "prettier": "^3.6.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0"
}
