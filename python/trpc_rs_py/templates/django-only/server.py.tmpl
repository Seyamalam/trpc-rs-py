"""{{name}} — Django + tRPC server generated by `trpc-py init`.

Run it:

    python server.py

Then in another terminal, keep TypeScript types in sync while you edit:

    trpc-py dev --app server:router --out app-router.d.ts

Settings are configured inline to keep the starter one file — a real project
would use `settings.py` / `urls.py` / `wsgi.py` as usual.
"""

from __future__ import annotations

import os
from collections.abc import AsyncIterator

import django
from django.conf import settings

settings.configure(
    DEBUG=False,
    ALLOWED_HOSTS=["*"],
    ROOT_URLCONF=__name__,
    SECRET_KEY="change-me-in-production",
    DATABASES={},
    INSTALLED_APPS=["django.contrib.contenttypes"],
)
django.setup()

from django.urls import path  # noqa: E402
from pydantic import BaseModel  # noqa: E402

from trpc_rs_py import RestRoute, Router, mount_rest  # noqa: E402
from trpc_rs_py.django import asgi_view  # noqa: E402
from trpc_rs_py.django import urlpatterns as trpc_urlpatterns  # noqa: E402


class User(BaseModel):
    """Response model — becomes a named TypeScript interface."""

    id: int
    name: str


router = Router()


@router.query(rest=RestRoute("GET", "/greeting/{name}"))
def greeting(name: str) -> str:
    """A query procedure, callable via tRPC and REST at /api/greeting/<name>."""
    return f"Hello, {name}!"


@router.mutation
def create_user(name: str) -> User:
    """A mutation procedure — tRPC only (no REST route declared)."""
    return User(id=1, name=name)


@router.subscription
async def ticks() -> AsyncIterator[int]:
    """A subscription: the client receives each yielded value over SSE.

    The sync view streams it through a worker thread; under ASGI prefer
    `trpc_urlpatterns(router, asynchronous=True)` for real backpressure.
    """
    import asyncio

    for index in range(3):
        yield index
        await asyncio.sleep(0.5)


urlpatterns = [
    # Sync view — the right default for WSGI deployments. For ASGI use
    # trpc_urlpatterns(router, asynchronous=True) and asgi_view_async instead.
    *trpc_urlpatterns(router, sse_ping_interval=5.0),
    path("api/<path:path>", asgi_view(mount_rest(router, title="{{name}}", version="0.1.0"))),
]

if __name__ == "__main__":
    import socketserver
    from wsgiref.simple_server import WSGIServer, make_server

    from django.core.wsgi import get_wsgi_application

    class _ThreadingWSGIServer(socketserver.ThreadingMixIn, WSGIServer):
        daemon_threads = True

    make_server(
        "127.0.0.1",
        int(os.environ.get("PORT", "8000")),
        get_wsgi_application(),
        server_class=_ThreadingWSGIServer,
    ).serve_forever()
