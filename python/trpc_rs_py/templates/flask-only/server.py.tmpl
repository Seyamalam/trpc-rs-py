"""{{name}} — Flask + tRPC server generated by `trpc-py init`.

Run it:

    python server.py

Then in another terminal, keep TypeScript types in sync while you edit:

    trpc-py dev --app server:router --out app-router.d.ts
"""

from __future__ import annotations

import os
from collections.abc import AsyncIterator

from flask import Flask
from pydantic import BaseModel
from werkzeug.middleware.dispatcher import DispatcherMiddleware

from trpc_rs_py import RestRoute, Router, mount_rest, mount_wsgi, wsgi_from_asgi


class User(BaseModel):
    """Response model — becomes a named TypeScript interface."""

    id: int
    name: str


router = Router()


@router.query(rest=RestRoute("GET", "/greeting/{name}"))
def greeting(name: str) -> str:
    """A query procedure, callable via tRPC and REST at /api/greeting/<name>."""
    return f"Hello, {name}!"


@router.mutation
def create_user(name: str) -> User:
    """A mutation procedure — tRPC only (no REST route declared)."""
    return User(id=1, name=name)


@router.subscription
async def ticks() -> AsyncIterator[int]:
    """A subscription: the client receives each yielded value over SSE.

    Under WSGI each open stream holds one worker thread; set
    `sse_ping_interval` on `mount_wsgi` so dropped connections are noticed.
    """
    import asyncio

    for index in range(3):
        yield index
        await asyncio.sleep(0.5)


app = Flask(__name__)
app.wsgi_app = DispatcherMiddleware(
    app.wsgi_app,
    {
        "/trpc": mount_wsgi(router, sse_ping_interval=5.0),
        "/api": wsgi_from_asgi(mount_rest(router, title="{{name}}", version="0.1.0")),
    },
)

if __name__ == "__main__":
    from werkzeug.serving import run_simple

    run_simple("127.0.0.1", int(os.environ.get("PORT", "8000")), app, threaded=True)
